{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/preview_production_outcome.schema.json",
  "title": "NASDAQ Cafe Preview Production Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "episodeDate",
    "canonicalWorkflow",
    "plotCommit",
    "rendererCommit",
    "state",
    "previewHandoffReady",
    "previewPublicationReady",
    "finalRendered"
  ],
  "properties": {
    "contractVersion": {"const": "1.1.0"},
    "episodeDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "canonicalWorkflow": {"const": ".github/workflows/chatgpt-daily-preview-production.yml"},
    "plotCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rendererCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state": {
      "enum": [
        "PREVIEW_PUBLICATION_READY",
        "WAITING_FOR_VISUAL_REQUIREMENTS",
        "WAITING_FOR_VISUAL_SOURCE_SELECTION",
        "WAITING_FOR_VISUAL_INTELLIGENCE_DECISION",
        "WAITING_FOR_VISUAL_RESELECTION",
        "WAITING_FOR_VISUAL_REVIEW",
        "SAFE_PAUSED",
        "FAILED"
      ]
    },
    "closureStatus": {"enum": ["PASS", "PREPARED", "REVIEW_REQUIRED", "FAIL"]},
    "requiredAction": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "previewHandoffReady": {"type": "boolean"},
    "previewPublicationReady": {"type": "boolean"},
    "requestPublicationReceipt": {"type": "string", "minLength": 1},
    "rendererRequestPath": {
      "type": "string",
      "pattern": "^handoff-preview-requests-v4/[0-9]{4}-[0-9]{2}-[0-9]{2}-plot-[1-9][0-9]*-[0-9a-f]{12}\\.json$"
    },
    "handoffArtifactName": {"type": "string", "minLength": 1},
    "handoffArtifactId": {"type": "string", "minLength": 1},
    "handoffArtifactUrl": {"type": "string", "minLength": 1},
    "handoffArtifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "finalRendered": {"const": false}
  }
}
