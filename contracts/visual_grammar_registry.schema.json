{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nasdaq-cafe.local/visual_grammar_registry.schema.json",
  "title": "NASDAQ Cafe Visual Grammar Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "grammarPhases",
    "transitionRoles",
    "grammars",
    "stageCompatibility"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "grammarPhases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["establish", "develop", "resolve"]}
    },
    "transitionRoles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["continue", "major-shift", "return", "close"]}
    },
    "grammars": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/grammar"}
    },
    "stageCompatibility": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/stageCompatibility"}
    }
  },
  "$defs": {
    "grammarId": {
      "enum": [
        "contradiction",
        "evidence",
        "gap",
        "causal",
        "reaction",
        "comparison",
        "verification",
        "assembly"
      ]
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammarId",
        "meaning",
        "candidateScenes",
        "allowedPhases",
        "prohibitions"
      ],
      "properties": {
        "grammarId": {"$ref": "#/$defs/grammarId"},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 240},
        "candidateScenes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 9}
        },
        "allowedPhases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["establish", "develop", "resolve"]}
        },
        "prohibitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "stageCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grammarId", "allowedStageIds"],
      "properties": {
        "grammarId": {"$ref": "#/$defs/grammarId"},
        "allowedStageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "contradiction-stage",
              "evidence-stage",
              "gap-stage",
              "causal-stage",
              "reaction-stage",
              "comparison-stage",
              "verification-stage",
              "assembly-stage"
            ]
          }
        }
      }
    }
  }
}
