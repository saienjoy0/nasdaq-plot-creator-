{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nasdaq-cafe.local/visual_grammar_timing_report.schema.json",
  "title": "NASDAQ Cafe Visual Grammar Timing Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "status",
    "timingBasis",
    "episodeId",
    "durationMode",
    "inputRenderSpecSha256",
    "semanticsSha256",
    "rendererCompatibilitySha256",
    "finalEpisodeContractSha256",
    "sceneRange",
    "fallbackDiversityRecheck",
    "selectedFallbackBeatIds",
    "unresolvedStateCount",
    "thresholds",
    "metrics",
    "beats",
    "failures",
    "warnings"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "FAIL"]},
    "timingBasis": {"const": "post-tts-production-data"},
    "episodeId": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "durationMode": {"enum": ["standard", "shortened"]},
    "inputRenderSpecSha256": {"$ref": "#/$defs/sha256"},
    "semanticsSha256": {"$ref": "#/$defs/sha256"},
    "rendererCompatibilitySha256": {"$ref": "#/$defs/sha256"},
    "finalEpisodeContractSha256": {"$ref": "#/$defs/sha256"},
    "sceneRange": {"const": "scene-01..scene-08"},
    "fallbackDiversityRecheck": {"const": "completed"},
    "selectedFallbackBeatIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:scene-0[1-9]-beat-[0-9]{3}|vb-0[1-9]-[0-9]{2})$"}
    },
    "unresolvedStateCount": {"const": 0},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "beats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/beat"}},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "appearance": {
      "enum": [
        "open-hero", "entity-canvas", "document-media", "metric-board",
        "progressive-chart", "causal-path", "dual-lane", "timeline-track",
        "split-comparison", "matrix-grid", "verification-gates",
        "picturebook-canvas", "assembly-map", "text-bridge"
      ]
    },
    "surface": {
      "enum": [
        "open-canvas", "entity", "media", "card-board", "plot", "network",
        "split", "matrix", "picturebook", "assembly", "text"
      ]
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sameAppearanceRunMaxMs", "dominantSurfaceMaxRatio", "cardBoardMaxRatio",
        "nonAnalysisMinMs", "bridgeTextMaxRatio", "bridgeTextMaxMs",
        "majorShiftStageMinMs"
      ],
      "properties": {
        "sameAppearanceRunMaxMs": {"const": 28000},
        "dominantSurfaceMaxRatio": {"const": 0.45},
        "cardBoardMaxRatio": {"const": 0.55},
        "nonAnalysisMinMs": {"enum": [8000, 10000]},
        "bridgeTextMaxRatio": {"const": 0.12},
        "bridgeTextMaxMs": {"const": 18000},
        "majorShiftStageMinMs": {"const": 4000}
      }
    },
    "durationMap": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "measuredBeatCount", "totalMeasuredMs", "appearanceClassCount",
        "dominantSurfaceCount", "majorShiftCount", "longestSameAppearanceRunMs",
        "longestSameAppearanceRunBeatIds", "dominantSurfaceMaxRatio",
        "dominantSurfaceMaxId", "cardBoardRatio", "nonAnalysisDurationMs",
        "bridgeTextDurationMs", "bridgeTextRatio", "appearanceDurationMs",
        "dominantSurfaceDurationMs"
      ],
      "properties": {
        "measuredBeatCount": {"type": "integer", "minimum": 1},
        "totalMeasuredMs": {"type": "number", "minimum": 0},
        "appearanceClassCount": {"type": "integer", "minimum": 1},
        "dominantSurfaceCount": {"type": "integer", "minimum": 1},
        "majorShiftCount": {"type": "integer", "minimum": 0},
        "longestSameAppearanceRunMs": {"type": "number", "minimum": 0},
        "longestSameAppearanceRunBeatIds": {"type": "array", "items": {"type": "string"}},
        "dominantSurfaceMaxRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "dominantSurfaceMaxId": {"anyOf": [{"$ref": "#/$defs/surface"}, {"type": "null"}]},
        "cardBoardRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "nonAnalysisDurationMs": {"type": "number", "minimum": 0},
        "bridgeTextDurationMs": {"type": "number", "minimum": 0},
        "bridgeTextRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "appearanceDurationMs": {"$ref": "#/$defs/durationMap"},
        "dominantSurfaceDurationMs": {"$ref": "#/$defs/durationMap"}
      }
    },
    "beat": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sceneId", "sceneNumber", "beatId", "startMs", "endMs", "durationMs",
        "visualGrammarId", "transitionRole", "appearanceClass", "dominantSurface",
        "stageShell", "selectedPath"
      ],
      "properties": {
        "sceneId": {"type": "string", "pattern": "^scene-0[1-8]$"},
        "sceneNumber": {"type": "integer", "minimum": 1, "maximum": 8},
        "beatId": {"type": "string"},
        "startMs": {"type": "number", "minimum": 0},
        "endMs": {"type": "number", "minimum": 0},
        "durationMs": {"type": "number", "minimum": 0},
        "visualGrammarId": {"enum": ["contradiction", "entity", "evidence", "gap", "causal", "reaction", "comparison", "verification", "analogy", "assembly", "bridge-text"]},
        "transitionRole": {"enum": ["continuation", "major-shift", "return", "closing"]},
        "appearanceClass": {"$ref": "#/$defs/appearance"},
        "dominantSurface": {"$ref": "#/$defs/surface"},
        "stageShell": {"type": "string", "minLength": 1},
        "selectedPath": {"enum": ["preferred", "fallback", "not-applicable"]}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "path", "beatId", "message", "actual", "limit", "unit"],
      "properties": {
        "code": {"enum": [
          "VG_SAME_APPEARANCE_RUN_TOO_LONG", "VG_DOMINANT_SURFACE_OVERWEIGHT",
          "VG_CARD_BOARD_OVERWEIGHT", "VG_NON_ANALYSIS_DURATION_TOO_LOW",
          "VG_BRIDGE_TEXT_OVERUSED", "VG_MAJOR_SHIFT_HOLD_TOO_SHORT",
          "VG_TIMING_METADATA_MISSING"
        ]},
        "path": {"type": "string", "minLength": 1},
        "beatId": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1},
        "actual": {"type": "number"},
        "limit": {"type": "number"},
        "unit": {"enum": ["ms", "ratio", "count"]}
      }
    },
    "warning": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "beatId", "durationMs", "recommendedMinMs", "recommendedMaxMs"],
      "properties": {
        "code": {"const": "VG_NON_ANALYSIS_BEAT_OUTSIDE_RECOMMENDED_RANGE"},
        "beatId": {"type": "string"},
        "durationMs": {"type": "number", "minimum": 0},
        "recommendedMinMs": {"const": 5000},
        "recommendedMaxMs": {"const": 8000}
      }
    }
  }
}
