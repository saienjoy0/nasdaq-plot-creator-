{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nasdaq-cafe.local/financial_recipe_plan.schema.json",
  "title": "NASDAQ Cafe Financial Recipe Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "episodeDate", "finalEpisodeContract",
    "episodePackageSha256", "intentContractVersion",
    "recipeRegistryVersion", "selections"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episodeDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "finalEpisodeContract": {"$ref": "#/$defs/fileRef"},
    "episodePackageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intentContractVersion": {"const": "1.1.0"},
    "recipeRegistryVersion": {"const": "1.0.0"},
    "selections": {
      "type": "array", "items": {"$ref": "#/$defs/selection"}
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": [
        "intentId", "sceneId", "visualBeatId", "eligibility",
        "selectedPath", "selectedPlanId", "selectedPlanSha256",
        "selectedRecipeId", "selectedVisualTemplateId", "templateVariant",
        "screenState", "sourceIds", "metricIds", "causalStepIds",
        "reasonCodes", "fallbackDiversityRecheck"
      ],
      "properties": {
        "intentId": {"type": "string", "pattern": "^fvi-[a-z0-9][a-z0-9._-]{2,80}$"},
        "sceneId": {"type": "string", "pattern": "^scene-0[1-9]$"},
        "visualBeatId": {"type": "string", "pattern": "^vb-0[1-9]-[0-9]{2}$"},
        "eligibility": {"enum": ["eligible", "fallback-required"]},
        "selectedPath": {"enum": ["preferred", "fallback"]},
        "selectedPlanId": {"type": "string", "pattern": "^fvp-[a-z0-9][a-z0-9._-]{2,100}$"},
        "selectedPlanSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selectedRecipeId": {"type": "string"},
        "selectedVisualTemplateId": {"type": "string"},
        "templateVariant": {"type": "string"},
        "screenState": {"type": "string"},
        "sourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^source-[0-9]{3}$"}},
        "metricIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "causalStepIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reasonCodes": {
          "type": "array", "uniqueItems": true,
          "items": {
            "enum": [
              "INTENT_NOT_APPROVED", "TARGET_BEAT_NOT_FOUND", "TARGET_SCENE_MISMATCH",
              "SOURCE_ID_NOT_FOUND", "METRIC_SOURCE_NOT_DECLARED", "CAUSAL_SOURCE_NOT_DECLARED",
              "EXPECTED_ACTUAL_ENTITY_MISMATCH", "EXPECTED_ACTUAL_UNIT_MISMATCH",
              "EXPECTED_ACTUAL_CURRENCY_MISMATCH", "EXPECTED_ACTUAL_PERIOD_MISMATCH",
              "GAP_VALUE_MISMATCH", "EXPECTED_ACTUAL_GAP_INCOMPLETE",
              "SESSION_DATE_MISMATCH", "DIVERGENCE_ENTITY_NOT_DISTINCT",
              "MARKET_METRIC_COUNT_INVALID", "MARKET_UNIT_MISMATCH",
              "MACRO_ANCHOR_COUNT_INVALID", "MACRO_CAUSAL_STEP_COUNT_INVALID",
              "SOURCE_EVIDENCE_EMPTY", "INTRADAY_SERIES_REQUIRED",
              "SERIES_DATA_NOT_VERIFIED", "RECIPE_TEMPLATE_PAIR_NOT_ALLOWED",
              "PREFERRED_PLAN_INVALID"
            ]
          }
        },
        "fallbackDiversityRecheck": {"enum": ["not-required", "required"]}
      },
      "allOf": [
        {
          "if": {"properties": {"selectedPath": {"const": "preferred"}}},
          "then": {
            "properties": {
              "eligibility": {"const": "eligible"},
              "reasonCodes": {"maxItems": 0},
              "fallbackDiversityRecheck": {"const": "not-required"}
            }
          }
        },
        {
          "if": {"properties": {"selectedPath": {"const": "fallback"}}},
          "then": {
            "properties": {
              "eligibility": {"const": "fallback-required"},
              "reasonCodes": {"minItems": 1},
              "fallbackDiversityRecheck": {"const": "required"}
            }
          }
        }
      ]
    }
  }
}
