{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/final_render_authorization.schema.json",
  "title": "NASDAQ Cafe Final Render Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "episode_date",
    "status",
    "final_requested",
    "renderSpecSha256",
    "previewRunId",
    "previewSha256",
    "previewTechnicalReportSha256",
    "humanPreviewReviewPath",
    "humanPreviewReviewSha256",
    "visualIntelligencePackageSha256",
    "visualIntelligenceValidationSha256"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episode_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "status": {"const": "approved"},
    "final_requested": {"const": true},
    "renderSpecSha256": {"$ref": "#/$defs/sha256"},
    "previewRunId": {"type": "string", "pattern": "^[0-9]+$"},
    "previewSha256": {"$ref": "#/$defs/sha256"},
    "previewTechnicalReportSha256": {"$ref": "#/$defs/sha256"},
    "humanPreviewReviewPath": {"type": "string", "pattern": "^verification/[0-9]{4}-[0-9]{2}-[0-9]{2}/human_preview_review\\.json$"},
    "humanPreviewReviewSha256": {"$ref": "#/$defs/sha256"},
    "visualIntelligencePackageSha256": {"$ref": "#/$defs/sha256"},
    "visualIntelligenceValidationSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
