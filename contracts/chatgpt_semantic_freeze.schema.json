{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/chatgpt_semantic_freeze_v1_2.schema.json",
  "title": "NASDAQ Cafe ChatGPT Semantic Freeze v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "authority",
    "episodeDate",
    "canonManifest",
    "parts",
    "dailySourcePackage",
    "canonicalAuthoring",
    "causalDossier",
    "causalDossierValidation",
    "editorialSemanticAcceptance",
    "sourceSetDigestSha256"
  ],
  "properties": {
    "contractVersion": {"const": "1.2.0"},
    "authority": {"const": "chatgpt-semantic-source"},
    "episodeDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "canonManifest": {"$ref": "#/$defs/fileBinding"},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/jsonBinding"}},
    "dailySourcePackage": {"$ref": "#/$defs/fileBinding"},
    "canonicalAuthoring": {"$ref": "#/$defs/jsonBinding"},
    "causalDossier": {"$ref": "#/$defs/jsonBinding"},
    "causalDossierValidation": {"$ref": "#/$defs/jsonBinding"},
    "editorialSemanticAcceptance": {"$ref": "#/$defs/jsonBinding"},
    "sourceSetDigestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "jsonBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "semanticSha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semanticSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
