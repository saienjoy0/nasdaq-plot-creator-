{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/chatgpt_semantic_freeze.schema.json",
  "title": "NASDAQ Cafe ChatGPT Semantic Freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "authority",
    "episodeDate",
    "parts",
    "dailySourcePackage",
    "sourceSetDigestSha256"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "authority": {"const": "chatgpt-semantic-source"},
    "episodeDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "semanticSha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semanticSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "dailySourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceSetDigestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
