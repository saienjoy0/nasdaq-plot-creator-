{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/editorial_semantic_acceptance_v1.0.schema.json",
  "title": "NASDAQ Cafe Editorial Semantic Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "episodeDate",
    "status",
    "authoring",
    "causalDossier",
    "causalDossierValidation",
    "canonManifest",
    "storySubdocuments",
    "validationProjections",
    "contractBindings",
    "errors"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episodeDate": {"type": "string", "format": "date"},
    "status": {"enum": ["PASS", "FAIL"]},
    "authoring": {"$ref": "#/$defs/jsonBinding"},
    "causalDossier": {"$ref": "#/$defs/fileBinding"},
    "causalDossierValidation": {"$ref": "#/$defs/fileBinding"},
    "canonManifest": {"$ref": "#/$defs/fileBinding"},
    "storySubdocuments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyPlan", "storyScript", "creativeReview"],
      "properties": {
        "storyPlan": {"$ref": "#/$defs/subdocumentBinding"},
        "storyScript": {"$ref": "#/$defs/subdocumentBinding"},
        "creativeReview": {"$ref": "#/$defs/subdocumentBinding"}
      }
    },
    "validationProjections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyPlan", "storyScript", "creativeReview"],
      "properties": {
        "storyPlan": {"$ref": "#/$defs/fileBinding"},
        "storyScript": {"$ref": "#/$defs/fileBinding"},
        "creativeReview": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "contractBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "jsonBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "semanticSha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semanticSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "subdocumentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonPointer", "semanticSha256"],
      "properties": {
        "jsonPointer": {"type": "string", "pattern": "^/"},
        "semanticSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
