{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nasdaq-cafe.local/financial_visual_intent.schema.json",
  "title": "NASDAQ Cafe Financial Visual Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "episodeDate",
    "intentId",
    "kind",
    "sceneIds",
    "metrics",
    "causalSteps",
    "sourceIds",
    "dataPrecision",
    "chartPolicy",
    "preferredRecipe",
    "fallbackRecipe",
    "status"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episodeDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "intentId": {"type": "string", "pattern": "^fvi-[a-z0-9][a-z0-9._-]{2,80}$"},
    "kind": {
      "enum": [
        "market-snapshot",
        "expectation-gap",
        "entity-divergence",
        "macro-transmission",
        "source-evidence"
      ]
    },
    "sceneIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^scene-0[1-9]$"}
    },
    "metrics": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "#/$defs/metric"}
    },
    "causalSteps": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/causalStep"}
    },
    "sourceIds": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source-[0-9]{3}$"}
    },
    "dataPrecision": {
      "enum": [
        "reported-result",
        "market-close",
        "verified-intraday-series",
        "derived-difference",
        "qualitative-only"
      ]
    },
    "chartPolicy": {"enum": ["no-series", "verified-series-only"]},
    "preferredRecipe": {
      "enum": [
        "market-pulse-grid",
        "earnings-surprise",
        "dual-asset-split",
        "macro-pressure",
        "source-receipt"
      ]
    },
    "fallbackRecipe": {
      "enum": [
        "opening-contradiction",
        "expected-anchor",
        "split-opposition",
        "causal-build",
        "news-media"
      ]
    },
    "status": {"enum": ["proposed", "approved"]},
    "editorialNote": {"type": ["string", "null"], "maxLength": 500}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "label",
        "role",
        "valueText",
        "numericValue",
        "unit",
        "currency",
        "period",
        "entityId",
        "sessionDate",
        "sourceIds"
      ],
      "properties": {
        "metricId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "role": {
          "enum": [
            "market",
            "expected",
            "actual",
            "gap",
            "left-entity",
            "right-entity",
            "macro-anchor",
            "supporting"
          ]
        },
        "valueText": {"type": "string", "minLength": 1, "maxLength": 80},
        "numericValue": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"], "maxLength": 40},
        "currency": {"type": ["string", "null"], "maxLength": 12},
        "period": {"type": ["string", "null"], "maxLength": 80},
        "entityId": {"type": ["string", "null"], "maxLength": 80},
        "sessionDate": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source-[0-9]{3}$"}
        }
      }
    },
    "causalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "label", "sourceIds"],
      "properties": {
        "stepId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 140},
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^source-[0-9]{3}$"}
        }
      }
    }
  }
}
