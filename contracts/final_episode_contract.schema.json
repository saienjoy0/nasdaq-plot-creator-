{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nasdaq-cafe.local/final_episode_contract.schema.json",
  "title": "NASDAQ Cafe Final Episode Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "episodeDate",
    "episodePackage",
    "visualGrammarSidecar",
    "visualGrammarContractVersion",
    "expectedConfirmed",
    "scene5CausalExceptionReason",
    "review",
    "sourceRegistry",
    "scenes",
    "financialVisuals"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.1.0"
    },
    "episodeDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "episodePackage": {
      "$ref": "#/$defs/fileRef"
    },
    "visualGrammarSidecar": {
      "$ref": "#/$defs/fileRef"
    },
    "visualGrammarContractVersion": {
      "const": "1.0.0"
    },
    "expectedConfirmed": {
      "type": "boolean"
    },
    "scene5CausalExceptionReason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "sourceRegistry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "financialVisuals": {
      "$ref": "#/$defs/financialVisuals"
    },
    "visualSources": {
      "$ref": "#/$defs/visualSources"
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "postInquisitionFinal",
        "approvedForProduction"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "approved",
            "approved-with-changes"
          ]
        },
        "postInquisitionFinal": {
          "const": true
        },
        "approvedForProduction": {
          "const": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "title",
        "publisher",
        "sourceType"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^source-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "enum": [
            "official",
            "company",
            "major-media",
            "analyst",
            "market-data",
            "other"
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneId",
        "visualBeats"
      ],
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^scene-0[1-9]$"
        },
        "visualBeats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/visualBeat"
          }
        }
      }
    },
    "visualBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualBeatId",
        "headline",
        "screenQuestion",
        "startCue",
        "endCue",
        "returnTarget",
        "fallbackHeadline",
        "fallbackQuestion",
        "visualGrammar"
      ],
      "properties": {
        "visualBeatId": {
          "type": "string",
          "pattern": "^vb-0[1-9]-[0-9]{2}$"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "screenQuestion": {
          "type": "string",
          "minLength": 1
        },
        "startCue": {
          "type": "string",
          "minLength": 1
        },
        "endCue": {
          "type": "string",
          "minLength": 1
        },
        "returnTarget": {
          "type": "string",
          "minLength": 1
        },
        "fallbackHeadline": {
          "type": "string",
          "minLength": 1
        },
        "fallbackQuestion": {
          "type": "string",
          "minLength": 1
        },
        "visualGrammar": {
          "$ref": "#/$defs/visualGrammar"
        }
      }
    },
    "visualGrammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "grammarId",
        "transitionRole",
        "returnTargetBeatId"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "grammarId": {
          "enum": [
            "contradiction",
            "entity",
            "evidence",
            "gap",
            "causal",
            "reaction",
            "comparison",
            "verification",
            "analogy",
            "assembly",
            "bridge-text"
          ]
        },
        "transitionRole": {
          "enum": [
            "continuation",
            "major-shift",
            "return",
            "closing"
          ]
        },
        "returnTargetBeatId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^vb-0[1-9]-[0-9]{2}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transitionRole": {
                "const": "return"
              }
            },
            "required": [
              "transitionRole"
            ]
          },
          "then": {
            "properties": {
              "returnTargetBeatId": {
                "type": "string",
                "pattern": "^vb-0[1-9]-[0-9]{2}$"
              }
            }
          },
          "else": {
            "properties": {
              "returnTargetBeatId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "visualSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "intents"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "intents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visualSourceIntent"
          }
        }
      }
    },
    "visualSourceIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "target",
        "presentationClass",
        "purpose",
        "sourceIds",
        "placement",
        "primary",
        "fallback"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "pattern": "^vsi-[a-z0-9][a-z0-9._-]{2,100}$"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "presentationClass": {
          "enum": [
            "source-document",
            "real-world-photo",
            "social-post",
            "generated-illustration",
            "existing-asset"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "sourceIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source-[0-9]{3}$"
          }
        },
        "placement": {
          "$ref": "#/$defs/visualSourcePlacement"
        },
        "primary": {
          "$ref": "#/$defs/visualSourceCandidate"
        },
        "fallback": {
          "$ref": "#/$defs/visualSourceCandidate"
        },
        "temporalEvidenceNeedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TVE-[0-9]{2,}$"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "visualSourcePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placementId",
        "role",
        "region",
        "fit",
        "focalPoint"
      ],
      "properties": {
        "placementId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "role": {
          "enum": [
            "main-media",
            "illustration",
            "entity-card",
            "picture-book"
          ]
        },
        "region": {
          "enum": [
            "main-stage",
            "main-primary",
            "main-entity"
          ]
        },
        "fit": {
          "enum": [
            "cover",
            "contain",
            "fill"
          ]
        },
        "focalPoint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        }
      }
    },
    "visualSourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "assetId",
        "sourceKind",
        "sourceLocator",
        "captureMethod",
        "captureSpec",
        "rightsStatus"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^vsp-[a-z0-9][a-z0-9._-]{2,120}$"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sourceKind": {
          "enum": [
            "existing-asset",
            "collector-document",
            "official-url",
            "web-page",
            "social-post",
            "wikimedia",
            "generated-image"
          ]
        },
        "sourceLocator": {
          "$ref": "#/$defs/visualSourceLocator"
        },
        "captureMethod": {
          "enum": [
            "registry-reference",
            "archive-file",
            "direct-download",
            "pdf-page-render",
            "webpage-screenshot",
            "social-capture",
            "mediawiki-fetch",
            "local-file-validation"
          ]
        },
        "captureSpec": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/visualSourceCaptureSpec"
            }
          ]
        },
        "rightsStatus": {
          "enum": [
            "cleared",
            "user-review-required",
            "not-required"
          ]
        }
      }
    },
    "visualSourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "localPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "minProperties": 1
    },
    "visualSourceCaptureSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "selector": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "viewport": {
          "$ref": "#/$defs/visualSourceViewport"
        },
        "crop": {
          "$ref": "#/$defs/visualSourceCrop"
        },
        "outputFormat": {
          "enum": [
            "png",
            "jpg",
            "webp"
          ]
        }
      }
    },
    "visualSourceViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 2160
        }
      }
    },
    "visualSourceCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "financialVisuals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annexVersion",
        "intents",
        "candidatePlans"
      ],
      "properties": {
        "annexVersion": {
          "const": "1.0.0"
        },
        "intents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intent"
          }
        },
        "candidatePlans": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.nasdaq-cafe.local/financial_visual_candidate_plan.schema.json"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentContractVersion",
        "intentId",
        "kind",
        "target",
        "metrics",
        "causalSteps",
        "sourceIds",
        "dataPrecision",
        "chartPolicy",
        "preferredPlanId",
        "fallbackPlanId",
        "status",
        "editorialNote",
        "selectionState"
      ],
      "properties": {
        "intentContractVersion": {
          "const": "1.1.0"
        },
        "intentId": {
          "type": "string",
          "pattern": "^fvi-[a-z0-9][a-z0-9._-]{2,80}$"
        },
        "kind": {
          "enum": [
            "market-snapshot",
            "expectation-gap",
            "entity-divergence",
            "macro-transmission",
            "source-evidence"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "metrics": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "causalSteps": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/causalStep"
          }
        },
        "sourceIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source-[0-9]{3}$"
          }
        },
        "dataPrecision": {
          "enum": [
            "reported-result",
            "market-close",
            "verified-intraday-series",
            "derived-difference",
            "qualitative-only"
          ]
        },
        "chartPolicy": {
          "enum": [
            "no-series",
            "verified-series-only"
          ]
        },
        "preferredPlanId": {
          "type": "string",
          "pattern": "^fvp-[a-z0-9][a-z0-9._-]{2,100}$"
        },
        "fallbackPlanId": {
          "type": "string",
          "pattern": "^fvp-[a-z0-9][a-z0-9._-]{2,100}$"
        },
        "status": {
          "const": "approved"
        },
        "editorialNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "selectionState": {
          "$ref": "#/$defs/selectionState"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneId",
        "visualBeatId"
      ],
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^scene-0[1-9]$"
        },
        "visualBeatId": {
          "type": "string",
          "pattern": "^vb-0[1-9]-[0-9]{2}$"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "label",
        "role",
        "valueText",
        "numericValue",
        "unit",
        "currency",
        "period",
        "entityId",
        "sessionDate",
        "sourceIds"
      ],
      "properties": {
        "metricId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "enum": [
            "market",
            "expected",
            "actual",
            "gap",
            "left-entity",
            "right-entity",
            "macro-anchor",
            "supporting"
          ]
        },
        "valueText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "numericValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "entityId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "sessionDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source-[0-9]{3}$"
          }
        }
      }
    },
    "causalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "label",
        "sourceIds"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source-[0-9]{3}$"
          }
        }
      }
    },
    "selectionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilerSelection",
        "selectedPlanId",
        "selectedRecipeId",
        "selectedVisualTemplateId",
        "compilerReasonCodes",
        "fallbackDiversityRecheck"
      ],
      "properties": {
        "compilerSelection": {
          "const": "not-run"
        },
        "selectedPlanId": {
          "type": "null"
        },
        "selectedRecipeId": {
          "type": "null"
        },
        "selectedVisualTemplateId": {
          "type": "null"
        },
        "compilerReasonCodes": {
          "type": "array",
          "maxItems": 0
        },
        "fallbackDiversityRecheck": {
          "const": "not-run"
        }
      }
    }
  }
}
