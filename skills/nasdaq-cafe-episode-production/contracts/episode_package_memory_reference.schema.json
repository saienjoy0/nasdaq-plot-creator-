{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/schemas/episode_package_memory_reference.schema.json",
  "title": "NASDAQ Cafe Episode Package Memory References",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_date", "references", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "episode_date": {"type": "string", "format": "date"},
    "references": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_reference_type",
        "memory_reference_id",
        "historical_confidence",
        "current_revalidation_status",
        "current_evidence_ids",
        "difference_from_previous",
        "editorial_use",
        "scene_ids",
        "public_usage_mode"
      ],
      "properties": {
        "memory_reference_type": {
          "enum": ["thread", "claim", "episode", "lesson", "daily", "weekly"]
        },
        "memory_reference_id": {"type": "string", "minLength": 1},
        "historical_confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "current_revalidation_status": {
          "enum": [
            "not_used",
            "supported",
            "partially_supported",
            "weakened",
            "invalidated",
            "unresolved",
            "historical_context_only"
          ]
        },
        "current_evidence_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^E-[0-9]{3}$"},
          "uniqueItems": true
        },
        "difference_from_previous": {"type": "string"},
        "editorial_use": {
          "enum": [
            "not_used",
            "research_lead",
            "comparison",
            "counterevidence",
            "explanation_context",
            "monitoring_point",
            "procedural_only"
          ]
        },
        "scene_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^scene-0[1-9]$"},
          "uniqueItems": true
        },
        "public_usage_mode": {
          "enum": [
            "current_supported_context",
            "historical_comparison",
            "counterevidence",
            "monitoring_point",
            "internal_only"
          ]
        }
      }
    }
  }
}
