{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/schemas/immutable_episode.schema.json",
  "title": "NASDAQ Cafe immutable episode revision provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "episode_date", "revision", "supersedes_revision", "correction_reason", "approval_status", "approved_at", "promoted_at", "source_fingerprint", "source_artifacts", "publication_record", "generated_memory_ids", "promotion_plan_digest"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "episode_date": {"type": "string", "format": "date"},
    "revision": {"type": "string", "pattern": "^v(?!000)[0-9]{3}$"},
    "supersedes_revision": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^v(?!000)[0-9]{3}$"}]},
    "correction_reason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "approval_status": {"enum": ["approved_preview", "published"]},
    "approved_at": {"type": "string", "minLength": 1},
    "promoted_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_package", "render_spec", "validator_report"],
      "properties": {
        "episode_package": {"$ref": "#/$defs/sourceArtifact"},
        "render_spec": {"$ref": "#/$defs/sourceArtifact"},
        "validator_report": {"$ref": "#/$defs/sourceArtifact"}
      }
    },
    "publication_record": {"$ref": "#/$defs/artifact"},
    "generated_memory_ids": {
      "type": "object", "additionalProperties": false,
      "required": ["threads", "claims", "aliases", "lessons"],
      "properties": {
        "threads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "lessons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "promotion_plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}
    },
    "sourceArtifact": {
      "type": "object", "additionalProperties": false, "required": ["original_path", "archive_path", "sha256", "bytes"],
      "properties": {"original_path": {"type": "string", "minLength": 1}, "archive_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}
    }
  }
}
