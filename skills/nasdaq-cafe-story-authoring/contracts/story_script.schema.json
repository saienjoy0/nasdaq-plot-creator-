{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nasdaq-cafe.local/contracts/story_script_v1.0.schema.json",
  "title":"NASDAQ Cafe Story Script Draft",
  "type":"object","additionalProperties":false,
  "required":["contract_version","episode_date","producer","story_plan","causal_dossier","scenes","retained_counterevidence_ids","unresolved_points"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "episode_date":{"type":"string","format":"date"},
    "producer":{"const":"chatgpt"},
    "story_plan":{"$ref":"#/$defs/fileRef"},
    "causal_dossier":{"$ref":"#/$defs/fileRef"},
    "scenes":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/scene"}},
    "retained_counterevidence_ids":{"$ref":"#/$defs/evidenceIds"},
    "unresolved_points":{"type":"array","items":{"$ref":"#/$defs/unresolvedPoint"}}
  },
  "$defs":{
    "fileRef":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "evidenceIds":{"type":"array","items":{"type":"string","pattern":"^E-[0-9]{3,}$"},"uniqueItems":true},
    "confidence":{"type":"string","enum":["high","medium","low","unknown"]},
    "causalClaim":{"type":"object","additionalProperties":false,"required":["claim_id","statement","claim_type","evidence_ids","confidence","scope"],"properties":{"claim_id":{"type":"string","pattern":"^claim-[0-9]{2,}$"},"statement":{"type":"string","minLength":1},"claim_type":{"type":"string","enum":["fact","reported_interpretation","grounded_inference","unknown"]},"evidence_ids":{"$ref":"#/$defs/evidenceIds"},"confidence":{"$ref":"#/$defs/confidence"},"scope":{"type":"string","enum":["company","sector","nasdaq_support","reason_unknown"]}}},
    "scene":{"type":"object","additionalProperties":false,"required":["scene_id","formal_role","narration","connection_to_previous","evidence_ids","causal_claims"],"properties":{"scene_id":{"type":"string","pattern":"^scene-0[1-9]$"},"formal_role":{"type":"string","enum":["direction_and_conclusion","contradiction","confirmed_facts","expected_actual_gap","global_context","market_reaction","entity_divergence","validation_points","fixed_closing"]},"narration":{"type":"string","minLength":1},"connection_to_previous":{"type":"string"},"evidence_ids":{"$ref":"#/$defs/evidenceIds"},"causal_claims":{"type":"array","items":{"$ref":"#/$defs/causalClaim"}}}},
    "unresolvedPoint":{"type":"object","additionalProperties":false,"required":["statement","evidence_ids"],"properties":{"statement":{"type":"string","minLength":1},"evidence_ids":{"$ref":"#/$defs/evidenceIds"}}}
  }
}
