{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/schemas/research_input_manifest.schema.json",
  "title": "NASDAQ Cafe research input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "episode_date",
    "session",
    "inputs",
    "memory_intake",
    "validation"
  ],
  "properties": {
    "contract_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "episode_date": {
      "type": "string",
      "format": "date"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_date",
        "timezone",
        "information_cutoff"
      ],
      "properties": {
        "market_date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "information_cutoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily_source_package",
        "memory_query_plan",
        "memory_context",
        "memory_retrieval_report"
      ],
      "properties": {
        "daily_source_package": {
          "$ref": "#/$defs/fileRef"
        },
        "memory_query_plan": {
          "$ref": "#/$defs/fileRef"
        },
        "memory_context": {
          "$ref": "#/$defs/fileRef"
        },
        "memory_retrieval_report": {
          "$ref": "#/$defs/fileRef"
        },
        "collector_source_pack": {
          "$ref": "#/$defs/fileRef"
        }
      }
    },
    "memory_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_revalidation_required",
        "historical_context_only",
        "procedural",
        "not_selected"
      ],
      "properties": {
        "current_revalidation_required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectedMemory"
          }
        },
        "historical_context_only": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectedMemory"
          }
        },
        "procedural": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectedMemory"
          }
        },
        "not_selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejectedMemory"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "selectedMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_type",
        "item_id",
        "path",
        "historical_confidence",
        "provenance_paths",
        "requires_current_revalidation",
        "retrieval_status"
      ],
      "properties": {
        "item_type": {
          "enum": [
            "core",
            "thread",
            "claim",
            "episode",
            "lesson",
            "weekly",
            "daily"
          ]
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "historical_confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "provenance_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requires_current_revalidation": {
          "type": "boolean"
        },
        "retrieval_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rejectedMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_type",
        "item_id",
        "reason",
        "detail"
      ],
      "properties": {
        "item_type": {
          "enum": [
            "thread",
            "claim",
            "episode",
            "lesson",
            "weekly",
            "daily"
          ]
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
