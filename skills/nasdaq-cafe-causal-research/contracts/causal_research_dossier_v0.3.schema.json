{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/schemas/causal_research_dossier_v0.3.schema.json",
  "title": "Nasdaq Cafe Causal Research Dossier v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "episode_date",
    "session",
    "input_provenance",
    "research_input_manifest",
    "contradictions",
    "research_questions",
    "evidence",
    "memory_revalidation",
    "expected_actual_gap",
    "timeline",
    "causal_edges",
    "factor_roles",
    "alternative_hypotheses",
    "contrary_evidence",
    "editorial_handoff",
    "validation",
    "carryover_results",
    "cross_market_assessment",
    "validation_candidates",
    "visual_evidence_needs"
  ],
  "properties": {
    "contract_version": {
      "const": "0.3.0"
    },
    "episode_date": {
      "type": "string",
      "format": "date"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_date",
        "timezone",
        "information_cutoff"
      ],
      "properties": {
        "market_date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "information_cutoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_reference",
          "role",
          "version_or_hash"
        ],
        "properties": {
          "path_or_reference": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "daily_input",
              "source_of_truth",
              "historical_context",
              "other"
            ]
          },
          "version_or_hash": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "research_input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "contradictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "rank",
          "selection_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-[0-9]{2}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "perspective",
          "question",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-[0-9]{2}$"
          },
          "perspective": {
            "enum": [
              "official_evidence",
              "expectation",
              "timeline",
              "company_network",
              "macro_transmission",
              "historical_context",
              "counter_hypothesis",
              "other"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "parent_question_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "answered",
              "partially_answered",
              "unresolved",
              "discarded"
            ]
          },
          "answer_summary": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "memory_revalidation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memoryRevalidation"
      }
    },
    "expected_actual_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "actual",
        "gap"
      ],
      "properties": {
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis_class",
            "statement",
            "evidence_ids"
          ],
          "properties": {
            "status": {
              "enum": [
                "confirmed",
                "partially_confirmed",
                "unconfirmed",
                "not_applicable"
              ]
            },
            "basis_class": {
              "enum": [
                "official_consensus",
                "prior_company_guidance",
                "major_reporting",
                "analyst_view",
                "price_derived_inference",
                "unconfirmed",
                "not_applicable"
              ]
            },
            "statement": {
              "type": "string"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^E-[0-9]{3}$"
              },
              "uniqueItems": true
            }
          }
        },
        "actual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "evidence_ids"
          ],
          "properties": {
            "statement": {
              "type": "string"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^E-[0-9]{3}$"
              },
              "uniqueItems": true
            }
          }
        },
        "gap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "market_meaning",
            "confidence"
          ],
          "properties": {
            "statement": {
              "type": "string"
            },
            "market_meaning": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "timestamp_or_window",
          "timezone",
          "event",
          "precision",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{2}$"
          },
          "timestamp_or_window": {
            "type": "string",
            "minLength": 1
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "precision": {
            "enum": [
              "exact",
              "minute",
              "session",
              "date_only",
              "reported_only",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "causal_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_node",
          "to_node",
          "mechanism",
          "evidence_ids",
          "timing_alignment",
          "confidence",
          "strongest_alternative",
          "editorially_required",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EDGE-[0-9]{2}$"
          },
          "from_node": {
            "type": "string",
            "minLength": 1
          },
          "to_node": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "timing_alignment": {
            "enum": [
              "strong",
              "partial",
              "weak",
              "not_testable",
              "conflicting"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "strongest_alternative": {
            "type": "string"
          },
          "editorially_required": {
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "company_direct",
              "sector_support",
              "nasdaq_wide",
              "context_only"
            ]
          }
        }
      }
    },
    "factor_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_candidate",
        "amplifiers",
        "offsetting",
        "unresolved"
      ],
      "properties": {
        "primary_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "amplifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offsetting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "alternative_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hypothesis",
          "supporting_evidence_ids",
          "weakening_evidence_ids",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ALT-[0-9]{2}$"
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "weakening_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "credible",
              "weakened",
              "rejected",
              "unresolved"
            ]
          }
        }
      }
    },
    "contrary_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "evidence_ids",
          "effect_on_confidence"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "effect_on_confidence": {
            "enum": [
              "none",
              "minor",
              "material",
              "decisive"
            ]
          }
        }
      }
    },
    "editorial_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisional_lead",
        "central_hypothesis",
        "confidence",
        "company_direct_material",
        "nasdaq_wide_material",
        "causal_spine",
        "headline_beyond_discovery",
        "exclude_from_narration",
        "unresolved_questions",
        "next_validation_points",
        "memory_differences"
      ],
      "properties": {
        "provisional_lead": {
          "type": "string",
          "minLength": 1
        },
        "central_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "company_direct_material": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nasdaq_wide_material": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "causal_spine": {
          "type": "string",
          "minLength": 1
        },
        "headline_beyond_discovery": {
          "type": "string",
          "minLength": 1
        },
        "exclude_from_narration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_validation_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memory_differences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "carryover_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationResult"
      }
    },
    "cross_market_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materiality",
        "rationale",
        "evidence_ids",
        "alternatives"
      ],
      "properties": {
        "materiality": {
          "enum": [
            "material",
            "not_material",
            "unresolved"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "alternatives": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/crossMarketAlternative"
          }
        }
      }
    },
    "validation_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationCandidate"
      }
    },
    "visual_evidence_needs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visualEvidenceNeed"
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim",
        "evidence_class",
        "source_tier",
        "source_title",
        "source_issuer_or_publisher",
        "source_reference",
        "directness",
        "independence_group",
        "confidence",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^E-[0-9]{3}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "fact",
            "reported_interpretation",
            "grounded_inference",
            "unknown"
          ]
        },
        "source_tier": {
          "enum": [
            "tier_1",
            "tier_2",
            "tier_3",
            "discovery_only",
            "unavailable"
          ]
        },
        "source_title": {
          "type": "string"
        },
        "source_issuer_or_publisher": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "event_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "directness": {
          "enum": [
            "direct",
            "supporting",
            "context"
          ]
        },
        "independence_group": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "limitations": {
          "type": "string"
        }
      }
    },
    "memoryRevalidation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://nasdaq-cafe.local/schemas/memory_revalidation.schema.json",
      "title": "NASDAQ Cafe memory revalidation entry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_reference_type",
        "memory_reference_id",
        "historical_confidence",
        "retrieval_use_mode",
        "revalidation_status",
        "current_evidence_ids",
        "difference_from_previous",
        "editorial_use",
        "notes"
      ],
      "properties": {
        "memory_reference_type": {
          "enum": [
            "thread",
            "claim",
            "episode",
            "lesson",
            "daily",
            "weekly"
          ]
        },
        "memory_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "historical_confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "retrieval_use_mode": {
          "enum": [
            "current_revalidation_required",
            "historical_context",
            "procedural"
          ]
        },
        "revalidation_status": {
          "enum": [
            "not_used",
            "supported",
            "partially_supported",
            "weakened",
            "invalidated",
            "unresolved",
            "historical_context_only"
          ]
        },
        "current_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "difference_from_previous": {
          "type": "string"
        },
        "editorial_use": {
          "enum": [
            "not_used",
            "research_lead",
            "comparison",
            "counterevidence",
            "explanation_context",
            "monitoring_point",
            "procedural_only"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "observationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "instrument_group",
        "metric",
        "session",
        "precision_required"
      ],
      "properties": {
        "market": {
          "type": "string",
          "minLength": 1
        },
        "instrument_group": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "const": "next_completed_regular_session"
        },
        "precision_required": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "status",
        "current_evidence_ids",
        "notes"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supports",
            "weakens",
            "contradicts",
            "inconclusive",
            "not_observed",
            "expired"
          ]
        },
        "current_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "completed_observation_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "validationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "hypothesis_reference",
        "question",
        "observation_target",
        "strengthen_condition",
        "weaken_condition",
        "max_observation_sessions",
        "importance",
        "watch_next_display_text"
      ],
      "properties": {
        "hypothesis_reference": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "observation_target": {
          "$ref": "#/$defs/observationTarget"
        },
        "strengthen_condition": {
          "type": "string",
          "minLength": 1
        },
        "weaken_condition": {
          "type": "string",
          "minLength": 1
        },
        "max_observation_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "importance": {
          "enum": [
            "material",
            "monitoring"
          ]
        },
        "watch_next_display_text": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^VC-[0-9]{2,}$"
        }
      }
    },
    "crossMarketAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "statement",
        "supporting_evidence_ids",
        "weakening_evidence_ids",
        "status"
      ],
      "properties": {
        "hypothesis_id": {
          "enum": [
            "H1",
            "H2",
            "H3",
            "H4"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "weakening_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "survives",
            "weakened",
            "rejected",
            "unresolved"
          ]
        }
      }
    },
    "visualEvidenceNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "need_id",
        "claim_reference",
        "evidence_ids",
        "presentation_need",
        "required_information"
      ],
      "properties": {
