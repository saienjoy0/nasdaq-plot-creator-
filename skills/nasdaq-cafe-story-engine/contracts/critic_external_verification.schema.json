{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nasdaq Cafe External Critic Runtime Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "episode_date",
    "orchestrator_id",
    "orchestrator_run_id",
    "author_invocation_id",
    "critic_invocation_id",
    "isolation_backend",
    "adapter_image",
    "network_mode",
    "started_at",
    "finished_at",
    "exit_code",
    "request_sha256",
    "bundle_manifest_sha256",
    "review_sha256",
    "repo_mounted",
    "input_mount_read_only",
    "author_context_mounted",
    "passed_environment_names",
    "stdout_sha256",
    "stderr_sha256",
    "stdout_bytes",
    "stderr_bytes"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "episode_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "orchestrator_id": {"type": "string", "minLength": 1},
    "orchestrator_run_id": {"type": "string", "minLength": 1},
    "author_invocation_id": {"type": "string", "minLength": 1},
    "critic_invocation_id": {"type": "string", "minLength": 1},
    "isolation_backend": {"const": "docker-readonly-bundle"},
    "adapter_image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "adapter_image_id": {"type": ["string", "null"]},
    "network_mode": {"enum": ["bridge", "none"]},
    "container_id": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "exit_code": {"const": 0},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repo_mounted": {"const": false},
    "input_mount_read_only": {"const": true},
    "author_context_mounted": {"const": false},
    "passed_environment_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0}
  }
}
