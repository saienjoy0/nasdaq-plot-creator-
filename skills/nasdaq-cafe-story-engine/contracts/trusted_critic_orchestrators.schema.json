{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nasdaq Cafe Trusted Critic Orchestrators",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "keys"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "orchestrator_id", "algorithm", "public_key_pem", "status"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "orchestrator_id": {"type": "string", "minLength": 1},
          "algorithm": {"const": "ed25519"},
          "public_key_pem": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "revoked"]}
        }
      }
    }
  }
}
