{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/contracts/creative_review_v1.1.schema.json",
  "title": "NASDAQ Cafe Creative Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "episode_date",
    "reviewer",
    "round",
    "scores",
    "total_score",
    "scene_checks",
    "immediate_failures",
    "findings",
    "verdict"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1.0"
    },
    "episode_date": {
      "type": "string",
      "format": "date"
    },
    "reviewer": {
      "type": "string",
      "enum": [
        "editorial_critic",
        "independent_critic"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening",
        "progression",
        "discovery",
        "clarity",
        "fox_voice",
        "late_payoff"
      ],
      "properties": {
        "opening": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "progression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "discovery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "clarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "fox_voice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "late_payoff": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "total_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "scene_checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/sceneCheck"
      }
    },
    "immediate_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "conditional",
        "restructure",
        "fail"
      ]
    }
  },
  "$defs": {
    "sceneCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "mode",
        "payoff_delivered",
        "belief_changed",
        "continuation_reason_natural",
        "closure_effective",
        "opening_promise_recovered",
        "procedural_language_dominant"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^scene-0[1-8]$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "continue",
            "close"
          ]
        },
        "payoff_delivered": {
          "type": "boolean"
        },
        "belief_changed": {
          "type": "boolean"
        },
        "continuation_reason_natural": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "closure_effective": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "opening_promise_recovered": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "procedural_language_dominant": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "issue_type",
        "scene_ids",
        "problem",
        "viewer_impact",
        "minimal_fix"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^finding-[0-9]{2,}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "issue_type": {
          "type": "string",
          "enum": [
            "REPEATED_CONCLUSION",
            "NO_BELIEF_CHANGE",
            "NO_NEW_EVIDENCE",
            "NO_NEW_EVIDENCE_OR_MEANING",
            "NO_PAYOFF",
            "FAKE_OPEN_LOOP",
            "DEAD_END_SCENE",
            "ANSWER_REVEALED_TOO_EARLY",
            "PROCEDURAL_NARRATION",
            "SCENE_ORDER_INTERCHANGEABLE",
            "FOX_VOICE_ABSENT",
            "NO_LATE_PAYOFF",
            "HOOK_EXHAUSTS_STORY",
            "NO_UNDERSTANDING_UPGRADE",
            "FAKE_UNDERSTANDING_UPGRADE",
            "ABSTRACT_EDITORIAL_LANGUAGE",
            "NO_BEFORE_CONTEXT",
            "NO_AFTER_IMPLICATION",
            "NO_MIDPOINT_TURN",
            "OPEN_LOOP_UNRESOLVED",
            "OPENING_PROMISE_NOT_RECOVERED",
            "ENDING_NOT_BOOKENDED",
            "FACT_STACKING",
            "LOW_INFORMATION_GAIN",
            "PAYOFF_DROUGHT",
            "WEAK_SURPRISE",
            "CAUSALITY_DRIFT",
            "COUNTEREVIDENCE_REMOVED",
            "TIMELINE_DRIFT",
            "NASDAQ_SCOPE_OVERREACH",
            "CLARITY_OVERLOAD",
            "TEMPORAL_RECAP_OVERLOAD",
            "TEMPORAL_CONTINUITY_WITHOUT_PAYOFF",
            "CROSS_MARKET_DECORATION",
            "TEMPORAL_VISUAL_EVIDENCE_MISSING",
            "FALSE_TEMPORAL_CAUSALITY"
          ]
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^scene-0[1-9]$"
          },
          "uniqueItems": true
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "viewer_impact": {
          "type": "string",
          "minLength": 1
        },
        "minimal_fix": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
