{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nasdaq-cafe.local/contracts/rewrite_patch_v1.0.schema.json",
  "title":"NASDAQ Cafe Targeted Rewrite Patch",
  "type":"object","additionalProperties":false,
  "required":["contract_version","episode_date","round","source_review_round","operations"],
  "properties":{"contract_version":{"const":"1.0.0"},"episode_date":{"type":"string","format":"date"},"round":{"type":"integer","minimum":1,"maximum":2},"source_review_round":{"type":"integer","minimum":1,"maximum":2},"operations":{"type":"array","items":{"$ref":"#/$defs/op"}}},
  "$defs":{"op":{"type":"object","additionalProperties":false,"required":["operation_id","operation","target_scene_ids","finding_ids","purpose","instruction"],"properties":{"operation_id":{"type":"string","pattern":"^patch-[0-9]{2,}$"},"operation":{"type":"string","enum":["rewrite_scene","compress_scene","replace_connector","move_reveal_within_scene","move_content_to_compatible_scene","add_clarity_bridge","add_callback","restore_counterevidence","restore_causality_wording","adjust_visual_beat"]},"target_scene_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^scene-0[1-9]$"},"uniqueItems":true},"finding_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^finding-[0-9]{2,}$"},"uniqueItems":true},"purpose":{"type":"string","minLength":1},"instruction":{"type":"string","minLength":1}}}}
}
